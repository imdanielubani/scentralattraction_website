# Secrets and local configuration: never commit
.env
.env.*
!.env.example
*.pem
*.key
auth.json
wp-config.php
wp-config-local.php
local-config.php

# Dependencies
node_modules/
vendor/

# Build caches (the theme's assets/dist is committed so the theme works without Node)
.cache/
*.map

# Local WordPress test environment
.wp-test/
local-wp/
*.sql
*.sql.gz

# Release scratch (the final ZIP in releases/ IS committed)
releases/tmp/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.log
npm-debug.log*
