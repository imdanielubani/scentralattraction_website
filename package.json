{
  "name": "scentral-attraction-theme",
  "version": "1.2.0",
  "private": true,
  "description": "Build tooling for the Scentral Attraction WordPress theme. Not required at runtime.",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "images": "node scripts/optimize-images.mjs",
    "lint:php": "node scripts/lint-php.mjs",
    "test": "node tests/check-theme.mjs",
    "package": "npm run build && python scripts/package_theme.py",
    "release": "npm run lint:php && npm run package",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.2.6",
    "@fontsource/cormorant-garamond": "^5.2.6",
    "esbuild": "^0.25.10",
    "playwright-core": "^1.55.0",
    "sharp": "^0.34.4"
  }
}
