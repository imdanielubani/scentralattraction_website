{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"layout": { "contentSize": "760px", "wideSize": "1440px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "black", "name": "Black", "color": "#0A0A0A" },
				{ "slug": "ink", "name": "Ink", "color": "#111111" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" },
				{ "slug": "surface", "name": "Light grey", "color": "#F5F5F5" },
				{ "slug": "red", "name": "Logo red", "color": "#E3151C" },
				{ "slug": "grey", "name": "Grey", "color": "#5C5C5C" }
			]
		}
	}
}
